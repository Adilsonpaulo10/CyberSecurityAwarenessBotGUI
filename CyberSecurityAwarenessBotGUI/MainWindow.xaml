<Window x:Class="CyberSecurityAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="600"
        Width="900">

    <Grid Background="#1E1E1E">

        <TabControl Margin="10">

            <!-- CHATBOT -->
            <TabItem Header="Chatbot">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="asciiLogo"
                               Grid.Row="0"
                               FontFamily="Consolas"
                               Background="Black"
                               Foreground="Lime"
                               Margin="0,0,0,10"/>

                    <RichTextBox x:Name="chatBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 Background="Black"
                                 Foreground="Lime"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">

                        <TextBox x:Name="inputBox"
                                 Width="650"
                                 Margin="0,0,10,0"/>

                        <Button x:Name="sendBtn"
                                Width="120"
                                Content="Send"
                                Click="sendBtn_Click"/>
                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- TASKS -->
            <TabItem Header="Tasks">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="taskTitleBox"
                             Margin="0,0,0,10"
                             Height="30"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal">

                        <TextBox x:Name="taskDescriptionBox"
                                 Width="250"
                                 Margin="0,0,10,0"/>

                        <TextBox x:Name="reminderBox"
                                 Width="150"
                                 Margin="0,0,10,0"/>

                        <Button Content="Add Task"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="AddTask_Click"/>

                        <Button Content="Complete"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="CompleteTask_Click"/>

                        <Button Content="Delete"
                                Width="120"
                                Click="DeleteTask_Click"/>

                    </StackPanel>

                    <ListBox x:Name="taskListBox"
                             Grid.Row="2"/>

                </Grid>

            </TabItem>

            <!-- QUIZ -->
            <TabItem Header="Quiz">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="questionText"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1">

                        <Button x:Name="optionA"
                                Margin="0,5"
                                Click="Option_Click"/>

                        <Button x:Name="optionB"
                                Margin="0,5"
                                Click="Option_Click"/>

                        <Button x:Name="optionC"
                                Margin="0,5"
                                Click="Option_Click"/>

                        <Button x:Name="optionD"
                                Margin="0,5"
                                Click="Option_Click"/>

                    </StackPanel>

                    <TextBlock x:Name="scoreText"
                               Grid.Row="2"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,20,0,0"/>

                </Grid>

            </TabItem>

            <!-- LOGS -->
            <TabItem Header="Activity Logs">

                <Grid Margin="10">

                    <ListBox x:Name="logListBox"/>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>